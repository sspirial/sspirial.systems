rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Replace the OWNER_EMAIL value below if you change it in the app
    // (src/shell/auth.ts). Only the signed-in user with this email can
    // perform write operations; everyone else has read-only access.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'core@sspirial.systems';
    }

    match /{document=**} {
      // Public read
      allow get, list: if true;

      // Writes (create, update, delete) allowed only for the owner user
      allow write: if isOwner();
    }
  }
}
